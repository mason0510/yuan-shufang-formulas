meta {
  name: auth rejects a short password
  type: http
  seq: 7
}

post {
  url: https://progress.tap365.org/v1/auth/register
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "email": "bad",
    "password": "short"
  }
}

assert {
  res.status: eq 400
}
