meta {
  name: external rejects a one character query
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/formulas/external
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "q": "咳"
  }
}

assert {
  res.status: eq 400
}

tests {
  test("short query is rejected before any paid call", function() {
    expect(res.body.error.message).to.equal("q 至少 2 个字");
  });
}
